# ── Backend ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb://localhost:27017/filedrop

# Backblaze B2 — BACKEND-ONLY SECRETS. Never expose these to the frontend.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=FileDrop
B2_ENDPOINT=

# Origin allowed to call the API (CORS)
FRONTEND_ORIGIN=http://localhost:3000

# Limits
MAX_FILE_SIZE=10GB
MAX_ACTIVE_STORAGE=9GB
DEFAULT_EXPIRATION_HOURS=24
MAX_EXPIRATION_HOURS=168

# Upload tuning
MULTIPART_PART_SIZE=16MB
PRESIGNED_URL_TTL_SECONDS=900
RESERVATION_TTL_MINUTES=60

# Rate limits (requests per hour per IP)
RATE_LIMIT_UPLOAD_PER_HOUR=20
RATE_LIMIT_DOWNLOAD_PER_HOUR=60

# ── Frontend (frontend-safe / public) ───────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000

# ── Cron (backend only) ──────────────────────────────────────────────
# Must also be set as CRON_SECRET in your Vercel project environment variables.
# Vercel Cron injects `Authorization: Bearer <CRON_SECRET>` on every cron call.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=85f00811af8661db7029434722e0efe70916446a03c347b21145424cc50f2914
